{
  "description": "Shared completion tone and model-free secondary agent verification offers/reminders.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .agents\\scripts\\task-complete.ps1",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .agents\\scripts\\secondary-verification.ps1 -Mode hook -Agent codex",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .agents\\scripts\\secondary-verification.ps1 -Mode hook -Agent codex",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .agents\\scripts\\secondary-verification.ps1 -Mode hook -Agent codex",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
